{
  "name": "skillsforge-ci-pipeline",
  "version": "1.0.0",
  "description": "A tiny Node.js HTTP service used to demonstrate a lint -> test -> build -> package GitHub Actions pipeline.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "node scripts/build.mjs",
    "start": "node src/server.js",
    "start:dist": "node dist/server.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
